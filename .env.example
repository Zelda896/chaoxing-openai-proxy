# ---- Server ----
PORT=8686
HOST=127.0.0.1
SERVE_UI=1

# ---- Target robot ----
UNIT_ID=21354
ROBOT_ID=dfda0d9629b34e0fa59a9b57834b8c56

# ---- Model naming ----
MODEL_NAME=chaoxing-ai-librarian
# Extra aliases so clients that hardcode a model name still resolve (comma separated).
MODEL_ALIASES=gpt-4o-mini,gpt-3.5-turbo

# ---- Answer timing ----
# Max gap between upstream frames before an answer is considered finished (ms).
ANSWER_IDLE_MS=3000
# Hard ceiling for one question (ms).
ANSWER_TIMEOUT_MS=120000

# ---- API auth ----
# Comma separated keys accepted as `Authorization: Bearer <key>`.
# Leave empty for loopback-only use. Set this before exposing the server.
API_KEYS=

# ---- Agent (local tool execution) ----
# Root directory the file/exec tools may touch.
AGENT_ROOT=./agent-sandbox
AGENT_MAX_STEPS=6
AGENT_STEP_TIMEOUT_MS=30000
AGENT_MAX_TOOL_CALLS=20
# Set to 0 to disable the PowerShell/exec tool entirely.
AGENT_ALLOW_EXEC=1
# Set to 1 to let http_get reach private/internal addresses.
AGENT_ALLOW_PRIVATE=0

# ---- Upstream overrides (rarely needed) ----
# UPSTREAM_BASE=https://robot.chaoxing.com
# UPSTREAM_WS=wss://robot.chaoxing.com
# FE_VERSION=d2796afa2.26103019-production
